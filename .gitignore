# Blender renders and frame caches (10+ GB)
**/renders/
**/frames_*/

# Video outputs
*.mp4
*.mkv
*.mov
*.avi
*.webm

# Blender backups
*.blend1
*.blend2
*.blend@

# Python cache & temp files
**/__pycache__/
*.pyc

# Local credentials & secrets
*.key
credentials.json
.env

# OS metadata
Thumbs.db
.DS_Store

# Kaggle bundle (rebuild with make_kaggle_bundle.py)
_tools/kaggle/bundle/
_tools/kaggle/*.zip
_tools/kaggle/local_reference*.png

# Colab / render-test packages are generated, too big for git (GitHub limit 100 MB): rebuild with the scripts in colab/
Battle of Colachel/colab/*.zip
Battle of Colachel/colab/rtx4050_test/
Battle of Colachel/colab/rtx4050_s*/
